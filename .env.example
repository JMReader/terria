# Local development uses the SQLite repository until Supabase is configured.
TERRIA_ENV=development
TERRIA_CORS_ORIGINS=http://localhost:3000

# Required to turn on the Supabase (Postgres) repository.
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-<region>.pooler.supabase.com:6543/postgres
# DATABASE_DIRECT_URL=postgresql+psycopg://postgres:<password>@db.<ref>.supabase.co:5432/postgres
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=sb_publishable_...
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...   # server only
# SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
# SUPABASE_JWT_AUDIENCE=authenticated
# SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Owner de las filas que escribe el backend mientras no haya Auth por request.
# Si falta, se provisiona TERRIA_SYSTEM_EMAIL vía GoTrue Admin API (service role).
# TERRIA_DEFAULT_OWNER_ID=<uuid de auth.users>
# TERRIA_SYSTEM_EMAIL=terria-system@terria.local

# Overrides para Alembic si la conexión directa no resuelve (IPv6-only, etc.).
# MIGRATION_DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-<region>.pooler.supabase.com:6543/postgres

# SQLite fallback path (modo local sin Supabase) y almacenamiento de assets PNG.
# TERRIA_DB_PATH=data/terria.db
# TIMELAPSE_STORAGE_DIR=data/storage
