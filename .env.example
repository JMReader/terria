# Local development uses the in-memory repository until Supabase is configured.
TERRIA_ENV=development
TERRIA_CORS_ORIGINS=http://localhost:3000

# Required to turn on the Supabase repository.
# DATABASE_URL=postgresql+psycopg://...
# SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
# SUPABASE_JWT_AUDIENCE=authenticated

# ── Certificación en Solana ──────────────────────────────────────────────────
# "local" = validador en memoria (demo, sin red ni SOL). "devnet" = RPC real.
SOLANA_ANCHOR_PROVIDER=local
# SOLANA_CLUSTER=devnet
# SOLANA_RPC_URL=https://api.devnet.solana.com
# SOLANA_ISSUER_SECRET_KEY=<json byte array | base58 | base64>  # nunca commitear
